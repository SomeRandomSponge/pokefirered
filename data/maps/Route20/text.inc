Route20_Text_BarryIntro::
    .string "El agua es poco profunda aquí.\n"
    .string "Hay mucha gente nadando.$"

Route20_Text_BarryDefeat::
    .string "¡Splash!$"

Route20_Text_BarryPostBattle::
    .string "Ojalá pudiera subirme a mi Pokémon.\n"
    .string "Seguro tú no estas cansad{OA}.$"

Route20_Text_ShirleyIntro::
    .string "Las Islas Espuma son tranquilas.\n"
    .string "Estoy de vacaciones aquí.$"

Route20_Text_ShirleyDefeat::
    .string "¡Basta!$"

Route20_Text_ShirleyPostBattle::
    .string "Hay una enorme caverna debajo de\n"
    .string "esta isla.$"

Route20_Text_TiffanyIntro::
    .string "Me encanta flotar en las olas\n"
    .string "junto a los peces.$"

Route20_Text_TiffanyDefeat::
    .string "¡Yauch!$"

Route20_Text_TiffanyPostBattle::
    .string "¿Quieres flotar conmigo?$"

Route20_Text_IreneIntro::
    .string "¿También estás de vacaciones?$"

Route20_Text_IreneDefeat::
    .string "¡No tuviste piedad!$"

Route20_Text_IrenePostBattle::
    .string "En un pasado distante, las Islas\n"
    .string "Espuma solían ser una sola isla.$"

Route20_Text_DeanIntro::
    .string "¡Mira mis músculos!$"

Route20_Text_DeanDefeat::
    .string "¡Qué débil!$"

Route20_Text_DeanPostBattle::
    .string "¡Debería estar fortaleciendo a\n"
    .string "mi Pokémon, no a mí!$"

Route20_Text_DarrinIntro::
    .string "¿Por qué te subiste a un Pokémon?\n"
    .string "¿No sabes nadar?$"

Route20_Text_DarrinDefeat::
    .string "¡Auch!\n"
    .string "¡Me destruiste!$"

Route20_Text_DarrinPostBattle::
    .string "¡Subirse a un Pokémon parece\n"
    .string "divertido!$"

Route20_Text_RogerIntro::
    .string "Llegué aquí volando sobre mis\n"
    .string "Pokémon pájaros.$"

Route20_Text_RogerDefeat::
    .string "¡Oh, no!\n"
    .string "¿Que voy a hacer ahora?$"

Route20_Text_RogerPostBattle::
    .string "Mis pájaros están exhaustos.\n"
    .string "¡No podemos Volar de regreso!$"

Route20_Text_NoraIntro::
    .string "Mi novio me dio unas perlas\n"
    .string "grandes.$"

Route20_Text_NoraDefeat::
    .string "¡Oh, no!\n"
    .string "¡Mis perlas estaban en ellas!$"

Route20_Text_NoraPostBattle::
    .string "¿Crecerán mis perlas dentro de\n"
    .string "Cloyster?$"

Route20_Text_MissyIntro::
    .string "Nadé hasta aquí desde Isla Canela.\n"
    .string "No fue nada fácil.$"

Route20_Text_MissyDefeat::
    .string "¡Estoy tan decepcionada!$"

Route20_Text_MissyPostBattle::
    .string "Los Pokémon invadieron una mansión\n"
    .string "abandonada en Isla Canela.\p"
    .string "Ahora la llaman Mansión Pokémon.$"

Route20_Text_MelissaIntro::
    .string "Al oeste de Isla Canela, hay un\n"
    .string "Laboratorio Pokémon.\p"
    .string "Mi papi trabaja ahí.$"

Route20_Text_MelissaDefeat::
    .string "¡Espera!\n"
    .string "¡Se supone que debes esperarme!$"

Route20_Text_MelissaPostBattle::
    .string "Canela es una isla volcánica.\p"
    .string "Se dice que salió del mar tras\n"
    .string "la erupción de un volcán.$"

Route20_Text_SeafoamIslands::
    .string "Islas Espuma$"

Route20_Text_MistyTrainsHere::
    .string "Hay muchos Entrenadores fuertes\n"
    .string "y Pokémon de tipo Agua por aquí.\p"
    .string "Dicen que Misty, del Gimnasio\n"
    .string "de Celeste, entrena aquí.$"
